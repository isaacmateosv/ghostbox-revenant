#!/bin/sh
# Load the Core Audio driver, replug the Mbox in software, and start the panel for the logged-in user.
# Also removes what builds from before the rename installed (Mbox 3 Control.app, Mbox3.driver).
DRIVER="/Library/Audio/Plug-Ins/HAL/GhostBoxRevenant.driver"
APP="/Applications/GhostBox Revenant GUI.app"
chown -R root:wheel "$DRIVER" 2>/dev/null
rm -rf "/Library/Audio/Plug-Ins/HAL/Mbox3.driver" "/Applications/Mbox 3 Control.app"
pkgutil --forget local.mbox3.native >/dev/null 2>&1 || true
killall coreaudiod 2>/dev/null || true
sleep 2
# Restarting Core Audio mid-stream can leave the Mbox ignoring playback until it is replugged
"$APP/Contents/Resources/mbox3-ctl" reenumerate >/dev/null 2>&1 || true
# Watch Core Audio for 3 minutes; remove the driver again if it pins the CPU (log: /var/tmp/ghostbox-revenant-driver.log)
/bin/sh "$APP/Contents/Resources/install-driver.sh" watch-background >/dev/null 2>&1 || true
CONSOLE_USER=$(stat -f %Su /dev/console)
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    launchctl asuser "$(id -u "$CONSOLE_USER")" open "$APP" 2>/dev/null || true
fi
exit 0
